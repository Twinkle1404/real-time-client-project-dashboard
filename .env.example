# PostgreSQL connection string
# Replace <USER>, <PASSWORD>, <HOST>, <PORT>, and <DATABASE> with your values
DATABASE_URL="postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public"

# Server
PORT=4000
NODE_ENV=development

# Frontend URL (for CORS credentials)
FRONTEND_URL="http://localhost:5173"

# JWT Authentication Secrets (Must be at least 32 characters long)
JWT_ACCESS_SECRET="your-jwt-access-secret-at-least-32-chars-long"
JWT_REFRESH_SECRET="your-jwt-refresh-secret-at-least-32-chars-long"

# Token Expiry Durations
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Cookie Configuration
COOKIE_NAME="refreshToken"

# Background Job Configuration
# Cron schedule for server-side overdue task processor (default: '* * * * *' = every minute)
OVERDUE_TASK_CRON="* * * * *"
